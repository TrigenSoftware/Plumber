root = true

[*]
indent_style = space
indent_size = 2
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true
end_of_line = lf

# The installer is Python and POSIX sh, where 4 spaces is the convention.
# Scoped to those two, so recipe.json keeps the 2-space default.
[packages/installer/**.{py,sh}]
indent_size = 4
